# PocketBase instance (public — used by the browser SDK)
NEXT_PUBLIC_PB_URL=https://database.somewhere.com

# Superuser credentials, used ONLY by scripts/pb-setup.mjs. Never imported by app code.
PB_URL=https://database.somewhere.com
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# 32-byte hex secret for encrypting user-supplied AI API keys at rest (Phase 2).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOLTEON_SECRET=
